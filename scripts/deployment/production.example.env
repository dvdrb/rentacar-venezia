# Copy to .env.production by running ./scripts/deploy-production setup. Never commit real values.
PROJECT_ROOT=/absolute/path/to/rentacar-venezia
LOCAL_WP_ROOT=/Users/you/Local\ Sites/rentacar-venezia-local/app/public
LOCAL_WP_URL=http://rentacar-venezia-local.local
LOCAL_WP_COMMAND=wp
PRODUCTION_SSH_USER=u123456789
PRODUCTION_SSH_HOST=host.example.com
PRODUCTION_SSH_PORT=65002
PRODUCTION_SSH_IDENTITY_FILE=
PRODUCTION_ROOT=/home/u123456789/domains/rentacarvenezia.it/public_html
PRODUCTION_URL=https://rentacarvenezia.it
PRODUCTION_EXPECTED_DB_NAME=database_name
REMOTE_WP_COMMAND=wp
REMOTE_BACKUP_ROOT=~/rentacar-venezia-production-deployments
BACKUP_RETENTION_COUNT=10
SYNC_ACTIVE_THIRD_PARTY_PLUGINS=1
REMOTE_PRESERVE_PLUGINS=
RUN_BROWSER_TESTS=1
AUTO_ROLLBACK_CODE_FAILURE=1
