{
  "name": "rentacar-venezia-redesign",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "check:assets": "node scripts/check-asset-manifest.mjs",
    "seo:audit": "wp eval-file tools/local-wp/seo-audit.php",
    "update:phone-metadata": "node scripts/update-phone-metadata.mjs",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint theme/rentacar-venezia-v2/assets/src --max-warnings=0",
    "lint:css": "stylelint 'theme/rentacar-venezia-v2/style.css'",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test tests/browser/production-smoke.spec.ts",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run check:assets",
    "test:deployment": "bash tests/deployment/run.sh",
    "deploy:production": "./scripts/deploy-production",
    "deploy:production:verify": "./scripts/deploy-production verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.9"
  }
}
